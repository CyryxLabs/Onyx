name: Release packages

on:
  workflow_dispatch:
    inputs:
      version:
        description: Release version without the v prefix
        required: true
        default: 1.0.0
  push:
    tags:
      - "v*"

permissions:
  contents: read

jobs:
  build:
    name: ${{ matrix.label }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: windows-latest
            label: Windows x64
          - runner: macos-15
            label: macOS arm64
          - runner: macos-15-intel
            label: macOS Intel
          - runner: ubuntu-24.04
            label: Linux x64
          - runner: ubuntu-24.04-arm
            label: Linux arm64
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip
      - name: Install runtime and build dependencies
        run: python -m pip install -r requirements.txt -r requirements-build.txt
      - name: Install Linux browser system dependencies
        if: runner.os == 'Linux'
        run: python -m playwright install-deps chromium
      - name: Install Inno Setup
        if: runner.os == 'Windows'
        run: choco install innosetup --no-progress -y
      - name: Install AppImage tool
        if: runner.os == 'Linux'
        shell: bash
        run: |
          arch="$(uname -m)"
          curl -fL "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${arch}.AppImage" -o "$RUNNER_TEMP/appimagetool"
          chmod +x "$RUNNER_TEMP/appimagetool"
          echo "APPIMAGETOOL=$RUNNER_TEMP/appimagetool" >> "$GITHUB_ENV"
          echo "APPIMAGE_EXTRACT_AND_RUN=1" >> "$GITHUB_ENV"
      - name: Test source runtime
        run: python -m unittest discover -s tests
      - name: Build native package
        shell: bash
        env:
          RELEASE_VERSION: ${{ inputs.version }}
          TAG_NAME: ${{ github.ref_name }}
        run: |
          version="$RELEASE_VERSION"
          if [ -z "$version" ]; then version="${TAG_NAME#v}"; fi
          python scripts/build_release.py --version "$version"
      - name: Upload native artifacts
        uses: actions/upload-artifact@v4
        with:
          name: onyx-${{ matrix.runner }}
          path: release/*
          if-no-files-found: error
          retention-days: 30

  publish:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - uses: actions/download-artifact@v4
        with:
          pattern: onyx-*
          path: release
          merge-multiple: true
      - name: Enforce public release eligibility
        env:
          ONYX_PUBLIC_RELEASE_APPROVED: ${{ vars.ONYX_PUBLIC_RELEASE_APPROVED }}
        shell: bash
        run: |
          python scripts/check_release_eligibility.py \
            --version "${GITHUB_REF_NAME#v}" \
            --repository-approval "$ONYX_PUBLIC_RELEASE_APPROVED"
      - name: Publish GitHub release
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          gh release view "${GITHUB_REF_NAME}" >/dev/null 2>&1 || gh release create "${GITHUB_REF_NAME}" --title "Onyx ${GITHUB_REF_NAME#v}" --generate-notes
          gh release upload "${GITHUB_REF_NAME}" release/* --clobber
